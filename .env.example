# ─────────────────────────────────────────────────────────────────────────────
# WarrantyX — Environment Variables Example
# Copy this file to .env and fill in your own values.
# NEVER commit .env or .env.local to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Frontend public variables (safe to expose via VITE_*) ────────────────────
VITE_REOWN_PROJECT_ID=your_reown_project_id_here
VITE_BOHR_RPC_URL=https://rpc.bohr.life
VITE_BOHR_CHAIN_ID=968
VITE_WARRANTY_X_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
VITE_APP_URL=https://your-vercel-deployment-url.vercel.app

# ── Foundry deployment variables (NEVER expose via VITE_*) ───────────────────
PRIVATE_KEY=0xyour_deployer_private_key_here
BOHR_RPC_URL=https://rpc.bohr.life

