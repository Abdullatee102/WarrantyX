# ─────────────────────────────────────────────────────────────────────────────
# WarrantyX — .gitignore
# ─────────────────────────────────────────────────────────────────────────────

# ── Environment / secrets ─────────────────────────────────────────────────────
.env
.env.local
.env.*.local
.env.development
.env.production
!.env.example

# ── Dependencies ──────────────────────────────────────────────────────────────
node_modules/
frontend/node_modules/

# ── Frontend build artefacts ──────────────────────────────────────────────────
frontend/dist/
frontend/.vite/
frontend/coverage/
frontend/tsconfig*.tsbuildinfo

# ── Foundry build artefacts ───────────────────────────────────────────────────
cache/
out/
broadcast/
contract/cache/
contract/out/
contract/broadcast/

# ── Logs ──────────────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── OS ────────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── IDE ───────────────────────────────────────────────────────────────────────
.idea/
.vscode/settings.json
.vscode/launch.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ── Certificates / keys ───────────────────────────────────────────────────────
*.pem
*.key
*.p12
*.pfx
private_key*
deploy.key

# ── Foundry specific ─────────────────────────────────────────────────────────
foundry.lock

# ── TypeScript generated ──────────────────────────────────────────────────────
tsconfig*.tsbuildinfo
